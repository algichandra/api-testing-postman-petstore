        {
          "name": "Get User by Username",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Cek Status Code = 200 OK\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Validasi isi data User\r\npm.test(\"Validate User Profile Data\", function () {\r\n    var jsonData = pm.response.json();\r\n    \r\n    // Memastikan username sesuai dengan yang diminta\r\n    pm.expect(jsonData.username).to.eql(\"qa_algi_001\");\r\n    pm.expect(jsonData.firstName).to.eql(\"Algi\");\r\n    pm.expect(jsonData.email).to.eql(\"algi@test.com\");\r\n});"
                ]
              }
            }
