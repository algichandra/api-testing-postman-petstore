                  "// 1. Harus mengembalikan status code 404 Not Found\r\npm.test(\"Status code is 404 for missing user\", function () {\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\n// 2. Cek pesan error dari server\r\npm.test(\"Response indicates user not found\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.message).to.eql(\"User not found\");\r\n});"
