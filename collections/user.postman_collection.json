      "item": [
        {
          "name": "Create New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Cek apakah Status Code = 200 OK\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Cek apakah Response Time kurang dari 2 detik (2000 ms)\r\npm.test(\"Response time is less than 2000ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n\r\n// 3. Cek apakah response berupa JSON dan ada field message\r\npm.test(\"Response contains message ID\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.code).to.eql(200);\r\n    pm.expect(jsonData.message).to.be.a('string');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": 1001,\r\n  \"username\": \"qa_algi_001\",\r\n  \"firstName\": \"Algi\",\r\n  \"lastName\": \"Tester\",\r\n  \"email\": \"qa_algi_001@example.com\",\r\n  \"password\": \"TestPass123!\",\r\n  \"phone\": \"081234567890\",\r\n  \"userStatus\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            }
          },
          "response": []
        },
