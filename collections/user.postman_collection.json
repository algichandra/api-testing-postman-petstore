                  "// Biasanya API yang baik akan menolak dengan status 400 Bad Request atau 500 tergantung validasi server publik\r\npm.test(\"Status code handles invalid data type\", function () {\r\n    // Petstore Swagger terkadang mengembalikan 500 atau 400 untuk tipe data salah\r\n    pm.expect(pm.response.code).to.be.oneOf([400, 500]);\r\n});"
