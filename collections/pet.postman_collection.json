          "name": "Create New Pet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response time < 2000ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n\r\npm.test(\"Content-Type is JSON\", function () {\r\n    pm.response.to.have.header(\"Content-Type\", \"application/json\");\r\n});\r\n\r\nconst res = pm.response.json();\r\n\r\npm.test(\"Nama pet sesuai request\", function () {\r\n    pm.expect(res.name).to.eql(\"Bruno\");\r\n});\r\n\r\npm.test(\"Status available\", function () {\r\n    pm.expect(res.status).to.eql(\"available\");\r\n});\r\n\r\n// simpan id buat request berikutnya\r\n// pm.environment.set(\"petId\", res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": 0,\r\n  \"category\": { \"id\": 1, \"name\": \"dog\" },\r\n  \"name\": \"Bruno\",\r\n  \"photoUrls\": [\"http://example.com/bruno.jpg\"],\r\n  \"tags\": [{ \"id\": 1, \"name\": \"friendly\" }],\r\n  \"status\": \"available\"\r\n}",
